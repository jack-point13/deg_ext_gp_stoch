Cell["\<\
Low - temperature extreme points of Gibbs - preserving stochastic maps \
LowTempExtPoints constructs low - temperature extreme - point germs emerging \
from an admissible zero - temperature stochastic matrix . The Gibbs vector is \
parametrised by one variable for each distinct energy level, with the uniform \
ground - state contribution included explicitly . Column stochasticity and \
Gibbs preservation are imposed before candidate vertices are isolated by \
active zero - entry constraints . The retained candidates must admit non - \
negative entries, strictly positive Gibbs weights, and positive entries on \
the support of the starting matrix . After rewriting the Gibbs variables as \
Subscript[\[Gamma], i], the final limit test selects precisely those families \
that converge to the prescribed zero - temperature starting point . \
AllLowTExtPoints first generates the admissible zero - temperature starting \
matrices associated with the degeneracy structure and then constructs the low \
- temperature germs emerging from each of them .\
\>", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.9967237411505623`*^9, 3.9967237463173733`*^9}, {
  3.996723812801756*^9, 
  3.99672382142795*^9}},ExpressionUUID->"e40b80dc-9a9a-7446-bc2f-\
5857d4d2ebd2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LowTempExtPoints", "[", 
    RowBox[{"testPerm_", ",", "dim_", ",", "enStruct_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "zeroPos", ",", "zeroPosSubsets", ",", "perturb", ",", "vars", ",", 
       "gibbsPerturb", ",", "solution", ",", "perturbSol1", ",", "solSet", ",",
        "solZeros", ",", "perturbSol2", ",", "solSetUnparam", ",", 
       "correctness", ",", "correctPos", ",", "nonZeros", ",", "ens"}], "}"}],
      ",", 
     RowBox[{
      RowBox[{"ens", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"i", ",", 
            RowBox[{"enStruct", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "enStruct", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Assign", " ", "an", " ", "energy"}], "-", 
        RowBox[{
        "sector", " ", "label", " ", "to", " ", "each", " ", "basis", " ", 
         RowBox[{"state", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"nonZeros", "=", 
       RowBox[{"Position", "[", 
        RowBox[{"testPerm", ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "!=", "0"}], "&"}], ")"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Record", " ", "the", " ", "support", " ", "of", " ", "the", " ", 
         "zero"}], "-", 
        RowBox[{"temperature", " ", "starting", " ", 
         RowBox[{"matrix", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"zeroPos", "=", 
       RowBox[{"Position", "[", 
        RowBox[{"testPerm", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Locate", " ", "its", " ", "zero", " ", 
        RowBox[{"entries", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"zeroPosSubsets", "=", 
       RowBox[{"Subsets", "[", 
        RowBox[{"zeroPos", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"dim", "-", "1"}], ")"}], "^", "2"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Generate", " ", "candidate", " ", "sets", " ", "of", " ", "active", " ",
         "zero", " ", 
        RowBox[{"constraints", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"perturb", "=", 
       RowBox[{
        RowBox[{"Array", "[", 
         RowBox[{"x", ",", 
          RowBox[{"{", 
           RowBox[{"dim", ",", "dim"}], "}"}]}], "]"}], "/.", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"dim", ",", "i"}], "]"}], "->", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"x", "[", 
               RowBox[{"j", ",", "i"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"dim", "-", "1"}]}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "dim"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Construct", " ", "a", " ", "perturbation", " ", "with", " ", 
        "vanishing", " ", "column", " ", 
        RowBox[{"sums", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"vars", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"perturb", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{";;", 
            RowBox[{"-", "2"}]}], ",", ";;"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Collect", " ", "the", " ", "independent", " ", "perturbation", " ", 
        RowBox[{"variables", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"gibbsPerturb", "=", 
       RowBox[{
        RowBox[{"Array", "[", 
         RowBox[{"y", ",", "dim"}], "]"}], "/.", " ", 
        RowBox[{
         RowBox[{"y", "[", "i_", "]"}], ":>", 
         RowBox[{
          RowBox[{"y", "[", 
           RowBox[{
            RowBox[{"ens", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], "]"}], "+", 
          RowBox[{
           RowBox[{"KroneckerDelta", "[", 
            RowBox[{
             RowBox[{"ens", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "0"}], "]"}], "/", 
           RowBox[{"enStruct", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Parametrise", " ", "Gibbs", " ", "weights", " ", "by", " ", "energy",
          " ", "sector"}], ",", 
        RowBox[{
         RowBox[{"including", " ", "the", " ", "uniform", " ", "ground"}], "-", 
         RowBox[{"state", " ", 
          RowBox[{"term", "."}]}]}]}], "*)"}], 
      RowBox[{"solution", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"testPerm", "+", "perturb", "-", 
             RowBox[{"IdentityMatrix", "[", "dim", "]"}]}], ")"}], ".", 
           "gibbsPerturb"}], "==", "0"}], ",", "vars"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Impose", " ", "Gibbs", " ", 
        RowBox[{"preservation", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"perturbSol1", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"testPerm", "+", "perturb"}], ")"}], "/.", " ", 
        RowBox[{"solution", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Obtain", " ", "the", " ", "general", " ", "stochastic", " ", 
         "Gibbs"}], "-", 
        RowBox[{"preserving", " ", 
         RowBox[{"perturbation", "."}]}]}], "*)"}], 
      RowBox[{"Monitor", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"solSet", "=", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"solZeros", "=", 
               RowBox[{"Solve", "[", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"testPerm", "+", "perturb"}], ")"}], "/.", " ", 
                    RowBox[{"solution", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"i", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"i", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "==", 
                    "0"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "j"}], "}"}]}], "]"}], ",", "vars"}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Set", " ", "the", " ", "entries", " ", "selected", " ", "by", 
                " ", "j", " ", "to", " ", 
                RowBox[{"zero", "."}]}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"perturbSol2", "=", 
               RowBox[{"perturbSol1", "/.", " ", 
                RowBox[{"solZeros", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "zeroPosSubsets"}], "}"}]}], "]"}], "]"}]}], 
         ";"}], ",", "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Substitute", " ", "each", " ", "active"}], "-", 
          RowBox[{"constraint", " ", "solution", " ", "and", " ", "remove", " ", 
           RowBox[{"duplicates", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
        "j"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Display", " ", "the", " ", "currently", " ", "processed", " ", "set", 
        " ", "of", " ", "zero", " ", 
        RowBox[{"constraints", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"solSet", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Select", "[", 
         RowBox[{"solSet", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Dimensions", "[", "#", "]"}], "==", 
            RowBox[{"{", 
             RowBox[{"dim", ",", "dim"}], "}"}]}], "&"}]}], "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Retain", " ", "only", " ", "explicit", " ", "dim"}], "-", 
        "by", "-", 
        RowBox[{"dim", " ", "matrix", " ", 
         RowBox[{"solutions", "."}]}]}], "*)"}], 
      RowBox[{"solSetUnparam", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"solSet", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Intersection", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", "#", "]"}], ",", 
              RowBox[{"Union", "[", 
               RowBox[{
                RowBox[{"Flatten", "[", 
                 RowBox[{"perturb", "+", "testPerm"}], "]"}], ",", 
                RowBox[{"Flatten", "[", "perturb", "]"}], ",", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"-", "perturb"}], "]"}]}], "]"}]}], "]"}], "]"}], "==",
            "0"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Discard", " ", "candidates", " ", "containing", " ", "unresolved", " ",
         "perturbation", " ", 
        RowBox[{"variables", "."}]}], "*)"}], 
      RowBox[{"Monitor", "[", 
       RowBox[{
        RowBox[{"correctness", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"FullSimplify", "[", 
             RowBox[{"Reduce", "[", 
              RowBox[{
               RowBox[{"i", ">=", "0"}], "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"DeleteDuplicates", "[", "gibbsPerturb", "]"}], "/.",
                  " ", 
                 RowBox[{"List", "->", "Greater"}]}], ")"}], "&&", 
               RowBox[{"gibbsPerturb", ">", "0"}], "&&", 
               RowBox[{"ReplacePart", "[", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"i", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"j", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"j", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], ">", 
                    "0"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"j", ",", "nonZeros"}], "}"}]}], "]"}], ",", 
                 RowBox[{"0", "->", "And"}]}], "]"}]}], "]"}], "]"}], "===", 
            "False"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "solSetUnparam"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"MatrixForm", "[", "i", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"Test", " ", "non"}], "-", "negativity"}], ",", 
        RowBox[{"ordered", " ", "positive", " ", "Gibbs", " ", "weights"}], ",", 
        RowBox[{
        "and", " ", "positivity", " ", "on", " ", "the", " ", "initial", " ", 
         RowBox[{"support", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"correctPos", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"correctness", ",", "False"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Select", " ", "candidates", " ", "not", " ", "found", " ", "to", " ", 
        "be", " ", 
        RowBox[{"infeasible", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"solSetUnparam", "/.", " ", 
             RowBox[{
              RowBox[{"y", "[", "1", "]"}], "->", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"\[Gamma]", ",", "0"}], "]"}], "-", 
               RowBox[{"1", "/", 
                RowBox[{"enStruct", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}]}]}], "/.", " ", 
            RowBox[{
             RowBox[{"y", "[", "i_", "]"}], ":>", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\[Gamma]", ",", 
               RowBox[{"i", "-", "1"}]}], "]"}]}]}], "]"}], ")"}], "[", 
         RowBox[{"[", "correctPos", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Limit", "[", 
           RowBox[{
            RowBox[{"#", "/.", " ", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\[Gamma]", ",", "i_"}], "]"}], ":>", 
              RowBox[{"x", "^", "i"}]}]}], ",", 
            RowBox[{"x", "->", "0"}]}], "]"}], "==", "testPerm"}], "&"}]}], 
       "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Retain", " ", "the", " ", "families", " ", "converging", " ", "to", " ", 
     "testPerm", " ", "in", " ", "the", " ", "zero"}], "-", 
    RowBox[{"temperature", " ", 
     RowBox[{"limit", "."}]}]}], "*)"}], "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AllLowTExtPoints", "[", "struct_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dim", "=", 
       RowBox[{"Total", "[", "struct", "]"}]}], ",", "admat"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Determine", " ", "the", " ", "total", " ", "state"}], "-", 
