Cell[CellGroupData[{

Cell["Low-Temperature generation", "Section",
 InitializationCell->True,
 CellChangeTimes->{{3.9967248037597694`*^9, 
  3.996724809709669*^9}},ExpressionUUID->"3630f306-1e93-ef43-82b0-\
a81abab99980"],

Cell["\<\
Admissible zero - temperature starting matrices GenerateAdmissibleMatrices \
constructs the deterministic stochastic matrices that may serve as zero - \
temperature starting points for the low - temperature germ construction . The \
list m specifies the successive energy degeneracies . The basis is first \
partitioned into energy blocks in reversed order . For each block, rows may \
either map injectively within the same block or map to a block lying to its \
right in this internal ordering . Repeated targets are allowed for the latter \
assignments, while the final block must map bijectively onto itself . All \
compatible block assignments are combined and converted into binary matrices \
with one non - zero entry per row . The final transpose and reversal restore \
the original energy ordering and produce column - stochastic admissible \
matrices .\
\>", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.9967239024653015`*^9, 3.9967239165784607`*^9}, {
  3.9967240802814217`*^9, 
  3.9967241145595684`*^9}},ExpressionUUID->"43b73047-c475-a94e-ba63-\
eb20e8ad993f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"GenerateAdmissibleMatrices", "[", "m_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "k", ",", "n", ",", "ends", ",", "starts", ",", "ranges", ",", 
      "blockChoices", ",", "buildMatrix"}], "}"}], ",", 
    RowBox[{
     RowBox[{"k", "=", 
      RowBox[{"Length", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Number", " ", "of", " ", "distinct", " ", "energy", " ", 
       RowBox[{"sectors", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"Reverse", "[", "m", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Total", " ", "state"}], "-", 
       RowBox[{"space", " ", 
        RowBox[{"dimension", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ends", "=", 
      RowBox[{"Accumulate", "[", 
       RowBox[{"Reverse", "[", "m", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Final", " ", "basis", " ", "index", " ", "of", " ", "each", " ", 
       "block", " ", "in", " ", "reversed", " ", "energy", " ", 
       RowBox[{"order", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"starts", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Most", "[", "ends", "]"}], "+", "1"}], ",", "1"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Initial", " ", "basis", " ", "index", " ", "of", " ", "each", " ", 
       RowBox[{"block", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ranges", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Range", ",", 
        RowBox[{"{", 
         RowBox[{"starts", ",", "ends"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Basis", " ", "indices", " ", "belonging", " ", "to", " ", "the", " ", 
       "respective", " ", "energy", " ", 
       RowBox[{"blocks", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"blockChoices", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "diagCols", ",", "rightCols", ",", "ma", ",", "rows", ",", 
            "choices"}], "}"}], ",", 
          RowBox[{
           RowBox[{"diagCols", "=", 
            RowBox[{"ranges", "[", 
             RowBox[{"[", "a", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Columns", " ", "belonging", " ", "to", " ", "the", " ", 
             "current", " ", "energy", " ", 
             RowBox[{"block", "."}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"rightCols", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"a", "<", "k"}], ",", 
              RowBox[{"Flatten", "[", 
               RowBox[{"ranges", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"a", "+", "1"}], ";;", "k"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Columns", " ", "in", " ", "blocks", " ", "to", " ", "the", " ", 
             "right", " ", "of", " ", "the", " ", "current", " ", 
             RowBox[{"block", "."}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"ma", "=", 
            RowBox[{"Length", "[", "diagCols", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Degeneracy", " ", "of", " ", "the", " ", "current", " ", 
             "energy", " ", 
             RowBox[{"block", "."}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"rows", "=", 
            RowBox[{"Range", "[", "ma", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Local", " ", "row", " ", "indices", " ", "within", " ", "the", 
             " ", "current", " ", 
             RowBox[{"block", "."}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"choices", "=", 
            RowBox[{
             RowBox[{"Reap", "[", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "rightCols", "]"}], "==", "0"}], "&&", 
                    RowBox[{
                    RowBox[{"ma", "-", "i"}], ">", "0"}]}], ",", 
                   RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "Require", " ", "the", " ", "final", " ", "block", " ", 
                   "to", " ", "map", " ", "entirely", " ", "within", " ", 
                   RowBox[{"itself", "."}]}], "*)"}], "\[IndentingNewLine]", 
                 RowBox[{"Do", "[", 
                  RowBox[{
                   RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "offRows", ",", "diagAssignments", ",", 
                    "rightAssignments"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"offRows", "=", 
                    RowBox[{"Complement", "[", 
                    RowBox[{"rows", ",", "diagRows"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Rows", " ", "assigned", " ", "outside", " ", "the", " ", 
                    "current", " ", "diagonal", " ", 
                    RowBox[{"block", "."}]}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"diagAssignments", "=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"i", "==", "0"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"{", "}"}], "}"}], ",", 
                    RowBox[{"Permutations", "[", 
                    RowBox[{"diagCols", ",", 
                    RowBox[{"{", "i", "}"}]}], "]"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Injective", " ", "assignments", " ", "to", " ", 
                    "columns", " ", "within", " ", "the", " ", "same", " ", 
                    RowBox[{"block", "."}]}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"rightAssignments", "=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ma", "-", "i"}], "==", "0"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"{", "}"}], "}"}], ",", 
                    RowBox[{"Tuples", "[", 
                    RowBox[{"rightCols", ",", 
                    RowBox[{"ma", "-", "i"}]}], "]"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Unrestricted", " ", "assignments", " ", "to", " ", 
                    "columns", " ", "in", " ", "later", " ", 
                    RowBox[{"blocks", "."}]}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"target", "=", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"0", ",", "ma"}], "]"}]}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"target", "[", 
                    RowBox[{"[", 
                    RowBox[{"diagRows", "[", 
                    RowBox[{"[", "t", "]"}], "]"}], "]"}], "]"}], "=", 
                    RowBox[{"diagChoice", "[", 
                    RowBox[{"[", "t", "]"}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", "1", ",", "i"}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Assign", " ", "the", " ", "selected", " ", "rows", " ", 
                    "within", " ", "the", " ", "diagonal", " ", 
                    RowBox[{"block", "."}]}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"target", "[", 
                    RowBox[{"[", 
                    RowBox[{"offRows", "[", 
                    RowBox[{"[", "t", "]"}], "]"}], "]"}], "]"}], "=", 
                    RowBox[{"rightChoice", "[", 
                    RowBox[{"[", "t", "]"}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", "1", ",", 
                    RowBox[{"ma", "-", "i"}]}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Assign", " ", "the", " ", "remaining", " ", "rows", " ", 
                    "to", " ", "later", " ", 
                    RowBox[{"blocks", "."}]}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"Sow", "[", "target", "]"}]}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"rightChoice", ",", "rightAssignments"}], "}"}]}],
                     "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"diagChoice", ",", "diagAssignments"}], "}"}]}], 
                    "]"}], ";"}]}], "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Collect", " ", "every", " ", "compatible", " ", "target",
                     " ", 
                    RowBox[{"vector", "."}]}], "*)"}], "\[IndentingNewLine]", 
                    "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"diagRows", ",", 
                    RowBox[{"Subsets", "[", 
                    RowBox[{"rows", ",", 
                    RowBox[{"{", "i", "}"}]}], "]"}]}], "}"}]}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "0", ",", "ma"}], "}"}]}], "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Enumerate", " ", "assignments", " ", "with", " ", "every", " ", 
             "possible", " ", "number", " ", "of", " ", "diagonal", " ", 
             RowBox[{"rows", "."}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"choices", "===", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"{", "}"}], ",", 
             RowBox[{"First", "[", "choices", "]"}]}], "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "1", ",", "k"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Generate", " ", "the", " ", "admissible", " ", "target", " ", 
       "vectors", " ", "independently", " ", "for", " ", "each", " ", 
       RowBox[{"block", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"buildMatrix", "[", "targets_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"flatTargets", ",", "rowTargetPairs"}], "}"}], ",", 
        RowBox[{
         RowBox[{"flatTargets", "=", 
          RowBox[{"Flatten", "[", "targets", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Combine", " ", "the", " ", "blockwise", " ", "targets", " ", 
           "into", " ", "one", " ", "target", " ", "per", " ", 
           RowBox[{"row", "."}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"rowTargetPairs", "=", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", "n", "]"}], ",", "flatTargets"}], "}"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Pair", " ", "each", " ", "row", " ", "with", " ", "its", " ", 
           "assigned", " ", "target", " ", 
           RowBox[{"column", "."}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Normal", "@", 
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"rowTargetPairs", "->", "1"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Construct", " ", "the", " ", "corresponding", " ", "binary", " ", 
        "row"}], "-", 
       RowBox[{"stochastic", " ", 
        RowBox[{"matrix", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Reverse", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "#", "]"}], "\[Transpose]"}], "]"}], "&"}], 
       "/@", 
       RowBox[{"(", 
        RowBox[{"buildMatrix", "/@", 
         RowBox[{"Tuples", "[", "blockChoices", "]"}]}], ")"}]}], "]"}]}]}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Combine", " ", "all", " ", "block", " ", "choices"}], ",", 
    RowBox[{
     RowBox[{"transpose", " ", "to", " ", "column"}], "-", 
     RowBox[{"stochastic", " ", "form"}]}], ",", 
    RowBox[{
    "and", " ", "restore", " ", "the", " ", "original", " ", "energy", " ", 
     RowBox[{"ordering", "."}]}]}], "*)"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9967239024653015`*^9, 3.9967239165784607`*^9}, {
  3.9967240802814217`*^9, 3.9967241081495514`*^9}, {3.996726529639736*^9, 
